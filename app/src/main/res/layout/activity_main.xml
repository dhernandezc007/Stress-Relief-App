<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ocean"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp">

            <!-- Top bar: brand + streak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/fraunces_semibold"
                    android:text="@string/brand_name"
                    android:textColor="@color/still_navy"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/streakText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_bg"
                    android:fontFamily="@font/dm_sans_medium"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/still_navy"
                    android:textSize="13sp"
                    tools:text="🐚 3 day streak" />
            </LinearLayout>

            <!-- Greeting -->
            <TextView
                android:id="@+id/dateText"
                style="@style/Eyebrow"
                android:layout_marginTop="36dp"
                tools:text="Good afternoon · Monday, Nov 23" />

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/fraunces_regular"
                android:letterSpacing="-0.01"
                android:textColor="@color/still_ink"
                android:textSize="36sp"
                tools:text="Welcome, Danny" />

            <!-- Daily check-in -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Eyebrow"
                        android:text="@string/checkin_title" />

                    <!-- Form state -->
                    <LinearLayout
                        android:id="@+id/checkInForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_marginTop="8dp"
                            android:text="@string/checkin_prompt" />

                        <LinearLayout
                            android:id="@+id/moodScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/noteLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/checkin_note_hint"
                            android:visibility="gone"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="@color/still_navy"
                            app:cursorColor="@color/still_navy"
                            app:hintTextColor="@color/still_navy"
                            tools:visibility="visible">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/noteInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLines="4"
                                android:textColor="@color/still_ink" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveCheckIn"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="16dp"
                            android:enabled="false"
                            android:text="@string/checkin_save"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_button_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/primary_button_bg"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <!-- Completed state -->
                    <LinearLayout
                        android:id="@+id/checkInDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/doneEmoji"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:textSize="28sp"
                                tools:background="@color/mood_4"
                                tools:text="🙂" />

                            <TextView
                                android:id="@+id/doneTitle"
                                style="@style/SectionTitle"
                                android:layout_width="0dp"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                tools:text="Today you're feeling good" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditCheckIn"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/checkin_edit"
                                android:textColor="@color/still_navy" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/doneMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/still_muted"
                            android:textSize="15sp"
                            tools:text="Glad you're doing well. Keep that going." />

                        <TextView
                            android:id="@+id/doneNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/mood_card"
                            android:padding="14dp"
                            android:textColor="@color/still_ink"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            android:visibility="gone"
                            tools:text="“Went for a walk, felt better.”"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSuggestBreathe"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/checkin_try_breathing"
                            android:textAllCaps="false"
                            android:textColor="@color/still_navy"
                            android:visibility="gone"
                            app:backgroundTint="@color/still_foam"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Week overview -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Eyebrow"
                        android:text="@string/week_title" />

                    <LinearLayout
                        android:id="@+id/weekStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need a moment? -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginTop="32dp"
                android:text="@string/moment_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnAnxious"
                    style="@style/MoodTile"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/MoodTileEmoji"
                        android:text="🌊" />

                    <TextView
                        style="@style/MoodTileLabel"
                        android:text="@string/tile_anxious" />

                    <TextView
                        style="@style/MoodTileSub"
                        android:text="@string/tile_anxious_sub" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnUpset"
                    style="@style/MoodTile"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/MoodTileEmoji"
                        android:text="🌧️" />

                    <TextView
                        style="@style/MoodTileLabel"
                        android:text="@string/tile_upset" />

                    <TextView
                        style="@style/MoodTileSub"
                        android:text="@string/tile_upset_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnDepressed"
                    style="@style/MoodTile"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/MoodTileEmoji"
                        android:text="🌙" />

                    <TextView
                        style="@style/MoodTileLabel"
                        android:text="@string/tile_depressed" />

                    <TextView
                        style="@style/MoodTileSub"
                        android:text="@string/tile_depressed_sub" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBreathe"
                    style="@style/MoodTile"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/MoodTileEmoji"
                        android:text="🍃" />

                    <TextView
                        style="@style/MoodTileLabel"
                        android:text="@string/tile_breathe" />

                    <TextView
                        style="@style/MoodTileSub"
                        android:text="@string/tile_breathe_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- Daily reminder -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/still_navy">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/Eyebrow"
                        android:text="@string/reminder_title"
                        android:textColor="@color/still_tide" />

                    <TextView
                        android:id="@+id/affirmationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/fraunces_regular"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/still_bg"
                        android:textSize="20sp"
                        tools:text="Progress, not perfection." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Still ocean footer: back wave, boat, front wave -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp">

            <!-- Distant swell (mirrored so the crests don't line up) -->
            <ImageView
                android:id="@+id/waveBack"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_gravity="bottom"
                android:alpha="0.7"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:scaleX="-1"
                android:src="@drawable/wave_bottom"
                app:tint="@color/still_tide" />

            <ImageView
                android:id="@+id/boatImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="50dp"
                android:importantForAccessibility="no"
                android:src="@drawable/boat" />

            <!-- Near water, drawn over the hull so the boat sits in the sea -->
            <ImageView
                android:id="@+id/waveImage"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wave_bottom"
                app:tint="@color/still_current" />
        </FrameLayout>

        <!-- Fills the area behind the navigation bar so the sea reaches the edge -->
        <View
            android:id="@+id/navBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/still_current" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
