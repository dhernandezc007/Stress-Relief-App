<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/moodRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ocean"
    android:fillViewport="true"
    tools:context=".MoodActivity">

    <LinearLayout
        android:id="@+id/moodContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

        </LinearLayout>

        <!-- Header -->
        <TextView
            android:id="@+id/moodEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="40sp"
            tools:text="🌊" />

        <TextView
            android:id="@+id/moodEyebrow"
            style="@style/Eyebrow"
            android:layout_marginTop="12dp"
            tools:text="When you're feeling anxious" />

        <TextView
            android:id="@+id/moodTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/fraunces_regular"
            android:letterSpacing="-0.01"
            android:textColor="@color/still_ink"
            android:textSize="34sp"
            tools:text="Find your calm" />

        <!-- Ambient sound picker -->
        <TextView
            style="@style/Eyebrow"
            android:layout_marginTop="24dp"
            android:text="@string/sounds_title" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-24dp"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/soundChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/soundHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/still_muted"
            android:textSize="13sp"
            tools:text="Auto matches the time of day. Now playing morning birds." />

        <!-- Quote -->
        <com.google.android.material.card.MaterialCardView
            style="@style/StillCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/still_navy">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/Eyebrow"
                    android:text="@string/quote_title"
                    android:textColor="@color/still_tide" />

                <TextView
                    android:id="@+id/quoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:lineSpacingExtra="6dp"
                    android:minLines="2"
                    android:textColor="@color/still_bg"
                    android:textSize="24sp"
                    tools:text="Breathe. You are stronger than you think." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareQuote"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_share"
                        android:textColor="@color/still_tide" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewQuote"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quote_another"
                        android:textColor="@color/still_bg" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Coping tip -->
        <com.google.android.material.card.MaterialCardView
            style="@style/StillCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Eyebrow"
                    android:text="@string/tip_title" />

                <TextView
                    android:id="@+id/tipTitle"
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    tools:text="5-4-3-2-1 grounding" />

                <TextView
                    android:id="@+id/tipBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/still_muted"
                    android:textSize="15sp"
                    tools:text="Name 5 things you can see, 4 you can touch, 3 you can hear, 2 you can smell, and 1 you can taste." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBreathe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/start_breathing"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/still_navy"
            app:cornerRadius="16dp" />

        <!-- Pushes the support card to the bottom on tall screens -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- Crisis support -->
        <com.google.android.material.card.MaterialCardView
            style="@style/StillCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/still_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/support_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/support_body"
                    android:textColor="@color/still_navy"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCall988"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/support_call"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/still_navy"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnText988"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/support_text"
                        android:textAllCaps="false"
                        android:textColor="@color/still_navy"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/still_navy" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
