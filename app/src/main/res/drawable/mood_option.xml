<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F14304A">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/still_foam" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/still_navy" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/still_surface_alt" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
