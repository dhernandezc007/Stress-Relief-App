<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MoodRelief" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MoodRelief" parent="Base.Theme.MoodRelief">
        <!-- Still ocean colors for anything not styled directly (cursor, selection, ripples) -->
        <item name="colorPrimary">@color/still_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/still_foam</item>
        <item name="colorOnPrimaryContainer">@color/still_navy</item>
        <item name="colorSecondaryContainer">@color/still_foam</item>
        <item name="colorOnSecondaryContainer">@color/still_navy</item>
        <!-- Dialogs, menus and snackbars use these surfaces instead of Material's default lavender -->
        <item name="colorSurface">@color/still_surface</item>
        <item name="colorOnSurface">@color/still_ink</item>
        <item name="colorSurfaceContainerHigh">@color/still_surface</item>
        <item name="colorSurfaceContainerHighest">@color/still_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/still_muted</item>
        <item name="android:windowBackground">@color/still_bg</item>
        <!-- Launch screen: navy sea instead of the default pale purple -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/still_navy</item>

        <!-- App-wide font: DM Sans for all text unless a view says otherwise.
             Only set android:fontFamily here: AppCompat gives a theme-level app:fontFamily
             priority over a view's own android:fontFamily, which would override headings. -->
        <item name="android:fontFamily">@font/dm_sans</item>

        <!-- Material components (buttons, chips, text fields) use these text appearances -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Still.LabelLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Still.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Still.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Still.BodySmall</item>
    </style>

    <style name="TextAppearance.Still.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
    </style>

    <style name="TextAppearance.Still.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.Still.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>

    <style name="TextAppearance.Still.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
    </style>
</resources>
